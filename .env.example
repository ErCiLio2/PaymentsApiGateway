# ── Proxypay Sandbox ─────────────────────────────────────────────────────────
# Chave usada pelos clientes (eDuca, etc.) para autenticar no endpoint OPG
PROXYPAY_API_KEY=dev-proxypay-key

# ID do ponto de venda (configurado no painel Proxypay)
PROXYPAY_POS_ID=1

# Segredo HMAC para assinar os webhooks enviados ao cliente (mínimo 32 caracteres)
# Gerar com: openssl rand -hex 32
PROXYPAY_WEBHOOK_SECRET=CHANGE_ME_32_CHARS_MIN_WEBHOOK_SECRET

# URL pública desta instância do serviço Go (usada nos qrcode_url dos charges)
PROXYPAY_BASE_URL=http://localhost:8080

# URL pública da página web de aprovação (deeplink no QR code)
WEB_URL=http://localhost:3000

# ── Portas do host (opcional — útil para evitar conflitos em dev) ─────────────
# PROXYPAY_HOST_PORT=8080
# WEB_HOST_PORT=3000
