# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=kashe

# ── Proxypay API (compat v1) ──────────────────────────────────────────────────
# Chave usada pelos clientes (eDuca, etc.) para autenticar no endpoint OPG
PROXYPAY_API_KEY=dev-proxypay-key
PROXYPAY_POS_ID=1

# Segredo HMAC para assinar os webhooks (mínimo 32 caracteres)
# Gerar com: openssl rand -hex 32
PROXYPAY_WEBHOOK_SECRET=CHANGE_ME_32_CHARS_MIN_WEBHOOK_SECRET

# URLs públicas
KASHE_BASE_URL=http://localhost:8080
WEB_URL=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Google OAuth (criar em console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@kashe.dev

# ── Encriptação TOTP ──────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX

# ── Admin backoffice ──────────────────────────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_KEY=CHANGE_ME_ADMIN_KEY

# ── Portas do host (opcional) ─────────────────────────────────────────────────
# KASHE_HOST_PORT=8080
