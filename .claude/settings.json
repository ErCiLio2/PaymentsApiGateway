{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [[ \"$f\" == *.go ]] && /sgoinfre/eteixeir/.local/go-dist/go/bin/gofmt -w \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
